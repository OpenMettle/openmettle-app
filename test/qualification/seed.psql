-- CI-only seed for the hosted Flutter browser qualification, run by run.sh as
-- openmettle_owner with psql -X -q against the per-run database. It mirrors the approved
-- identity setup of core src/provider_keys/tests/postgres/browser.rs at the pinned revision:
-- register the provider and its first revision, set the ADR 0014 outstanding-login limit, and
-- create the synthetic user, identity and personal scope. Print the queued run, conversation,
-- root branch and fork IDs so the browser can exercise the real API. Core's unchanged
-- docs/operator/first-identity-approval.psql then approves the identity (ADR 0013).
-- Variables, all required: provider, issuer, client_id, revision, subject. Values are synthetic.
\set ON_ERROR_STOP on
\set VERBOSITY terse
-- ADR 0012 operator protocol for the first revision of a new provider.
BEGIN;
SET LOCAL lock_timeout = '2s';
SET LOCAL statement_timeout = '5s';
SET LOCAL synchronous_commit = on;
INSERT INTO openmettle.login_providers (id, issuer, client_id, changed_by, change_reason)
VALUES (:'provider'::uuid, :'issuer', :'client_id', 'fixture-owner', 'keycloak qualification provider');
INSERT INTO openmettle.login_provider_revisions (provider_id, revision)
VALUES (:'provider'::uuid, :'revision');
COMMIT;

-- Fresh migrations leave the limit NULL, which refuses every sign-in.
WITH admitted AS (
  UPDATE openmettle.login_admission
     SET outstanding_limit = 64, changed_by = 'fixture-owner',
         change_reason = 'synthetic test limit', changed_at = clock_timestamp()
   WHERE id
  RETURNING 1
)
SELECT count(*) = 1 AS admitted FROM admitted \gset
\if :admitted
\else
  DO $refused$ BEGIN RAISE EXCEPTION 'seed refused: login admission row missing'; END; $refused$;
\endif

BEGIN;
INSERT INTO openmettle.users DEFAULT VALUES RETURNING id::text AS user_id \gset
INSERT INTO openmettle.user_identities (user_id, issuer, subject)
VALUES (:'user_id'::uuid, :'issuer', :'subject');
INSERT INTO openmettle.scopes (kind, personal_user_id) VALUES ('personal', :'user_id'::uuid)
RETURNING id AS scope_id \gset

-- One queued personal run, with no worker or model dependency. The browser
-- driver cancels it through core after Flutter displays the queued snapshot.
INSERT INTO openmettle.conversations (scope_id, scope_kind, owner_user_id)
VALUES (:'scope_id', 'personal', :'user_id') RETURNING id AS conversation_id \gset
INSERT INTO openmettle.conversation_branches (scope_id, conversation_id)
VALUES (:'scope_id', :'conversation_id') RETURNING id AS branch_id \gset
-- Branches are paged by (created_at, id). Put both managed branches on
-- page two so Back has to restore a row outside the first 50.
INSERT INTO openmettle.conversation_branches (scope_id, conversation_id, created_at)
SELECT :'scope_id', :'conversation_id', now() - interval '1 day'
FROM generate_series(1, 50);
-- Publish a common turn, fork at that turn, then advance the two heads independently.
INSERT INTO openmettle.branch_heads (scope_id, conversation_id, branch_id)
VALUES (:'scope_id', :'conversation_id', :'branch_id');
INSERT INTO openmettle.messages (scope_id, conversation_id)
VALUES (:'scope_id', :'conversation_id') RETURNING id AS common_id \gset
INSERT INTO openmettle.message_turns (scope_id, conversation_id, message_id, author_user_id)
VALUES (:'scope_id', :'conversation_id', :'common_id', :'user_id');
INSERT INTO openmettle.message_parts (scope_id, conversation_id, message_id, ordinal, kind, text_value)
VALUES (:'scope_id', :'conversation_id', :'common_id', 0, 'text', 'Shared opening question.');
UPDATE openmettle.branch_heads SET head_message_id = :'common_id' WHERE branch_id = :'branch_id';

INSERT INTO openmettle.conversation_branches (scope_id, conversation_id, fork_message_id)
VALUES (:'scope_id', :'conversation_id', :'common_id') RETURNING id AS fork_id \gset
INSERT INTO openmettle.branch_heads (scope_id, conversation_id, branch_id, parent_branch_id, head_message_id)
VALUES (:'scope_id', :'conversation_id', :'fork_id', :'branch_id', :'common_id');

SELECT gen_random_uuid() AS message_id, gen_random_uuid() AS fork_message_id \gset
INSERT INTO openmettle.messages (id, scope_id, conversation_id, parent_message_id)
VALUES (:'message_id', :'scope_id', :'conversation_id', :'common_id'),
       (:'fork_message_id', :'scope_id', :'conversation_id', :'common_id');
INSERT INTO openmettle.message_turns (scope_id, conversation_id, message_id, author_user_id)
VALUES (:'scope_id', :'conversation_id', :'message_id', :'user_id'),
       (:'scope_id', :'conversation_id', :'fork_message_id', :'user_id');
INSERT INTO openmettle.message_parts (scope_id, conversation_id, message_id, ordinal, kind, text_value)
VALUES (:'scope_id', :'conversation_id', :'message_id', 0, 'text', 'Original branch follow-up.'),
       (:'scope_id', :'conversation_id', :'fork_message_id', 0, 'text', 'Alternate branch follow-up.');
UPDATE openmettle.branch_heads SET head_message_id = :'message_id' WHERE branch_id = :'branch_id';
UPDATE openmettle.branch_heads SET head_message_id = :'fork_message_id' WHERE branch_id = :'fork_id';

INSERT INTO openmettle.runs
    (scope_id, actor_user_id, conversation_id, branch_id, input_message_id,
     idempotency_key, snapshot_format, snapshot_version, input_snapshot,
     config_snapshot, request_identity, request_digest, last_event_sequence)
VALUES (:'scope_id', :'user_id', :'conversation_id', :'branch_id', :'message_id',
        'web-qualification', 'openmettle.synthetic-run', 1, ''::bytea, '{}'::bytea,
        'fixture'::bytea, sha256('fixture'::bytea), 1)
RETURNING id AS run_id \gset
INSERT INTO openmettle.run_events
    (scope_id, run_id, sequence, append_key, format, format_version, payload, identity, digest)
VALUES (:'scope_id', :'run_id', 1, 'run-created', 'openmettle.run-created', 1,
        ''::bytea, 'fixture'::bytea, sha256('fixture'::bytea));
COMMIT;
\echo :run_id :conversation_id :branch_id :fork_id
